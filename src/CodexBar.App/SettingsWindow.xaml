<Window x:Class="CodexBar.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexBar Settings" Width="520" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">
            <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <DockPanel>
                        <ComboBox x:Name="IntervalBox" DockPanel.Dock="Right" Width="130"
                                  SelectionChanged="OnIntervalChanged" />
                        <TextBlock Text="Refresh every" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox x:Name="StartupBox" Content="Start CodexBar when I sign in to Windows"
                              Margin="0,12,0,0" Foreground="{DynamicResource Fg}"
                              Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox x:Name="TrayProviderBox" DockPanel.Dock="Right" Width="190"
                                  SelectionChanged="OnTrayProviderChanged" />
                        <TextBlock Text="Tray icon follows" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox x:Name="TrayPerProviderBox" Content="Show a separate tray icon for each provider"
                              Margin="0,10,0,0" Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="Popup" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <CheckBox x:Name="StatusBox" Content="Check provider status pages and show incidents"
                              Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <CheckBox x:Name="PaceBox" Content="Show pace (whether a limit will run out before it resets)"
                              Margin="0,10,0,0" Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <CheckBox x:Name="HistoryBox" Content="Show a usage trend line for each limit"
                              Margin="0,10,0,0" Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <CheckBox x:Name="CostBox" Content="Estimate token spend from local Codex and Claude Code logs"
                              Margin="0,10,0,0" Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <CheckBox x:Name="NotifyBox" Content="Notify me when a limit passes a threshold"
                              Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <DockPanel Margin="22,8,0,0">
                        <TextBox x:Name="ThresholdsBox" DockPanel.Dock="Right" Width="130" Padding="4,2"
                                 ToolTip="Percent used, separated by commas, for example 50, 75, 90"
                                 LostFocus="OnThresholdsChanged" />
                        <TextBlock Text="Thresholds (% used)" VerticalAlignment="Center"
                                   Foreground="{DynamicResource FgDim}" />
                    </DockPanel>
                    <CheckBox x:Name="NotifyResetBox" Content="Notify me when a heavily used limit resets"
                              Margin="0,10,0,0" Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <CheckBox x:Name="NotifySignInBox" Content="Notify me when a provider's sign-in expires"
                              Margin="0,10,0,0" Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="Sign-in renewal" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <CheckBox x:Name="RefreshTokensBox" Content="Renew expired Codex and Claude sign-ins (experimental)"
                              Foreground="{DynamicResource Fg}"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource FgDim}"
                               Text="Off: CodexBar only reads the Codex and Claude Code credential files. On: when a token has expired, CodexBar renews it and writes the new tokens into that CLI's credential file. If that write fails, the CLI is signed out and you sign in again." />
                </StackPanel>
            </Border>

            <TextBlock Text="Providers" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8" />
            <StackPanel x:Name="ProviderList" />

            <TextBlock x:Name="ConfigWarning" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource Warn}" />
            <TextBlock x:Name="ConfigPath" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11"
                       Foreground="{DynamicResource FgDim}" />
        </StackPanel>
    </ScrollViewer>
</Window>
