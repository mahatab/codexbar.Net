<Window x:Class="CodexBar.App.SpendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexBar Usage &amp; Spend" Width="620" SizeToContent="Height" MaxHeight="820"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">
            <DockPanel>
                <StackPanel x:Name="ProviderTabs" DockPanel.Dock="Right" Orientation="Horizontal" />
                <TextBlock Text="Usage &amp; Spend" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource FgDim}"
                       Text="No local usage found yet. CodexBar reads the session logs Codex and Claude Code write on this PC; turn on the cost estimate in Settings and use either tool, then refresh." />

            <StackPanel x:Name="Body">
                <UniformGrid x:Name="Tiles" Rows="1" Margin="-4,14,-4,0" />

                <TextBlock Text="Daily spend · last 30 days" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12,14,10">
                    <StackPanel>
                        <Canvas x:Name="Chart" Height="150" ClipToBounds="True" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="ChartEnd" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource FgDim}" />
                            <TextBlock x:Name="ChartStart" FontSize="11" Foreground="{DynamicResource FgDim}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="By model" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,6,14,12">
                    <StackPanel x:Name="ModelRows" />
                </Border>

                <TextBlock Text="By project" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,6,14,12">
                    <StackPanel x:Name="ProjectRows" />
                </Border>

                <TextBlock Text="Token mix" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <Grid x:Name="MixBar" Height="10" />
                        <WrapPanel x:Name="MixLegend" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Footnote" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"
                           Foreground="{DynamicResource FgDim}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
